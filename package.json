{
  "name": "@exceeder/vuetrex",
  "type": "module",
  "version": "0.7.0",
  "description": "WebGL animated diagram visualizations in 3D for Vue 3",
  "main": "./dist/vuetrex.es.js",
  "module": "./dist/vuetrex.es.js",
  "sideEffects": false,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "concurrently --kill-others --names demos,docs --prefix-colors cyan,magenta \"pnpm run dev:demos\" \"pnpm run dev:docs\"",
    "dev:demos": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:docs": "pnpm run build && vitepress dev docs --host 127.0.0.1 --port 5174 --strictPort --base /docs/",
    "health:server": "node demo-health/server.mjs",
    "preinstall": "npx only-allow pnpm",
    "clean": "rm -rf ./dist && rm -rf ./dist_types && rm -rf ./coverage",
    "build": "rm -rf ./dist_types && vue-tsc --declaration --emitDeclarationOnly && node scripts/fix-declaration-imports.mjs && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:esm-project": "node test/esm-module/testNewProject.js",
    "test:health-server": "vitest run test/unit/verify-health-server.spec.ts",
    "tsc": "tsc",
    "docs:dev": "pnpm run dev:docs",
    "docs:build": "pnpm run build && vitepress build docs",
    "docs:serve": "vitepress serve docs"
  },
  "files": [
    "dist",
    "dist_types"
  ],
  "exports": {
    ".": {
      "types": "./dist_types/src/lib-components/index.d.ts",
      "import": "./dist/vuetrex.es.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exceeder/vuetrex.git"
  },
  "keywords": [
    "vue",
    "composition",
    "3d",
    "threejs",
    "diagram"
  ],
  "author": "Alex Pakka",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/exceeder/vuetrex/issues"
  },
  "homepage": "https://github.com/exceeder/vuetrex#readme",
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.186.0",
    "troika-three-text": "^0.52.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-glsl": "^1.6.1",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    },
    "troika-three-text": {
      "optional": true
    }
  },
  "peerDependencies": {
    "gsap": "^3.15.0",
    "three": "^0.186.0",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": ">=24"
  },
  "eslintConfig": {
    "rules": {
      "no-unused-vars": "off"
    }
  },
  "types": "./dist_types/src/lib-components/index.d.ts"
}
